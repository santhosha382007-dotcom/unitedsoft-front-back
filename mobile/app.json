{
  "expo": {
    "name": "UniSoft Team",
    "slug": "unisoft-team",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unitedsoft.attendance.team"
    },
    "android": {
      "package": "com.unitedsoft.attendance.team",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "FOREGROUND_SERVICE_CAMERA",
        "WAKE_LOCK",
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "READ_PHONE_STATE",
        "READ_PHONE_NUMBERS"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow UniSoft Team to access your location to verify attendance at office premises."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow UniSoft Team to access your photos for attendance selfie verification."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow UniSoft Team to use biometric authentication for check-in verification."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
